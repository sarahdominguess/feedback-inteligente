# Copie este arquivo para .env e preencha a chave abaixo.
# O arquivo real deve se chamar .env, contém segredos e nunca deve ser commitado.
DEEPSEEK_API_KEY=

# Opções da integração com a DeepSeek. Deixe em branco para usar o padrão
# definido em config.py. Nenhuma delas contém segredo.

# Nome do modelo. Vazio = usa LLM_MODELO_PADRAO (config.py).
# Os nomes mudam com o tempo; confira a documentação oficial antes de trocar.
#DEEPSEEK_MODEL=

# Raciocínio interno ("thinking") do modelo. Valores aceitos:
# disabled (desligado), enabled (ligado) ou omitir (não envia o parâmetro).
# Vazio = usa LLM_THINKING_PADRAO (config.py), hoje "disabled".
#DEEPSEEK_THINKING=
